# ==============================================================================
# WAMS — Local Development Environment
# ==============================================================================

# ── Application ───────────────────────────────────────────────────────────────
PORT=8080
ASPNETCORE_ENVIRONMENT=Development

# ── Database ───────────────────────────────────────────────────────────────────
# PostgreSQL
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=wams;Username=wams;Password=wams

# ── JWT Authentication ─────────────────────────────────────────────────────────
# Regenerate with: openssl rand -base64 64
Jwt__Secret=EXAMPLE_SECRET
Jwt__ExpirationMinutes=1440
Jwt__RefreshExpirationMinutes=10080

# ── Initial Seed Data ──────────────────────────────────────────────────────────
InitialCompany__Code=GCU-HQ
InitialCompany__Name=PT. Gerbang Cahaya Utama
InitialAdmin__Email=EXAMPLE_EMAIL
InitialAdmin__Password=EXAMPLE_PASS
InitialAdmin__Fullname=System Administrator

# ── CORS Configuration ─────────────────────────────────────────────────────────
CORS__Origins=http://localhost:5173,http://localhost:3000,http://localhost:8080
CORS__AllowCredentials=true