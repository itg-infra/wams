# Frontend server port used by both `npm run dev` and `npm start`.
FRONTEND_PORT=5173

# HTTPS
HTTPS=false
HTTPS_CERT_PATH=
HTTPS_CERT_PASSWORD=

# Vite reads these values at build time.
VITE_API_URL=http://localhost:8080/
VITE_API_URL_TEST=http://localhost:8080/
VITE_WAMS_API_URL=http://localhost:8080/
