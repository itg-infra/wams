# ==============================================================================
# WAMS - Local Development Environment
# Copy this file to .env and fill in the values.
# Values with spaces must be quoted (required for shell sourcing via `make run`).
# Docker Compose (env_file) also handles quoted values correctly.
# ==============================================================================

# Application
PORT=8080
ASPNETCORE_ENVIRONMENT=Development

# Logging (Serilog)
# Min level: Verbose | Debug | Information | Warning | Error | Fatal
Logging__MinLevel=Warning
# false = disable file logging (e.g. containers where stdout is collected externally)
Logging__WriteToFile=true

# Database
# Used only to init the postgres container in docker-compose (docker compose up).
# Keep these in sync with ConnectionStrings__DefaultConnection below - not read by the app directly.
POSTGRES_DB=wams
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin

# Full connection string for the app (local dev - localhost)
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=wams;Username=admin;Password=admin

# Apply pending EF Core migrations automatically on startup.
# Keep true for local dev/docker-compose convenience.
# Set to false in prod so migrations are applied as a separate, controlled deploy step
# (e.g. `dotnet ef database update` run manually/in CI before the app starts).
Database__AutoMigrate=true

# Run DatabaseSeeder on startup (roles/permissions/initial admin/static data).
# Keep true for local dev/docker-compose convenience.
# Set to false in prod once the DB is seeded, so startup doesn't re-run seed
# logic on every deploy - seeding is idempotent but adds startup time/DB round trips.
Database__AutoSeed=true

# JWT Authentication
# Regenerate with: openssl rand -base64 64
Jwt__Secret=CHANGE_ME
Jwt__ExpirationMinutes=15
Jwt__RefreshExpirationMinutes=10080
Jwt__IdleTimeoutMinutes=30

# Initial Seed Data
InitialCompany__Code=GCU
InitialCompany__Name="PT. Gerbang Cahaya Utama"
# Break-glass bootstrap account only
InitialAdmin__Email=sysadmin@gerbangcahayautama.com
InitialAdmin__Password=change-me-generate-a-strong-random-password
InitialAdmin__Fullname="System Administrator"

# ERP / SAP B1 Sync 
ErpApi__BaseUrl=https://erp.example.com:8020
# Per-attempt HTTP timeout in seconds (Polly wraps each retry attempt with this limit)
ErpApi__TimeoutSeconds=30
# Number of retry attempts on transient ERP errors (5xx, timeouts); exponential backoff at 2s base
ErpApi__RetryCount=3
# Seconds the circuit breaker stays open after the failure threshold is crossed
ErpApi__CircuitBreakerBreakSeconds=60
# true = use MockSapApiClient for PO/AP creation (fake numbers, no real HTTP call). Keep true for local dev.
ErpApi__UseMockSap=true
# SAP company database identifier passed as ?Entity= on every PO/AP call
ErpApi__SapEntity=Test
# Fixed department allocation on every PO/AP line
ErpApi__SapDepartmentCode=2LNW
# SAP project code sent when a line has no real project (missing/unmatched BillOfLading)
ErpApi__SapNoProjectCode=MV.0000001
# SAP division code sent when a line has no real division mapping (no linked SPK)
ErpApi__SapNoDivisionCode=1FMAC
# SAP product code sent when a line has no real SKU (no linked SPK)
ErpApi__SapNoProductCode=4NOP
# Doc currency sent on PO/AP/APDP requests. Optional - defaults to IDR if unset.
ErpApi__SapDocCurrency=IDR
# SAP DI API object-type code used as BaseType on AP invoice lines linked to a PO.
ErpApi__SapPoBaseType=22
# Enable/run master-data sync (vendors, items, tax types, warehouses, etc.) on startup
ErpApi__SyncEnabled=true
ErpApi__SyncRunOnStartup=true
# Minutes between master-data sync runs outside the peak window below
ErpApi__SyncIntervalMinutes=60
# Minutes between sync runs inside the peak window (e.g. faster during office hours)
ErpApi__SyncIntervalMinutesPeak=5
# Peak window is local hour [Start, End) in SyncPeakTimeZoneId - e.g. 8,17 = 08:00-17:00
ErpApi__SyncPeakWindowStartHour=8
ErpApi__SyncPeakWindowEndHour=17
# false = peak window applies every day, not just Mon-Fri
ErpApi__SyncPeakWeekdaysOnly=true
# IANA timezone ID the peak window is evaluated in
ErpApi__SyncPeakTimeZoneId=Asia/Jakarta

# CORS Configuration
CORS__Origins=http://localhost:5173,http://localhost:3000
CORS__AllowCredentials=true

# Budget Plan Approval Reminder
# Hourly scheduler that notifies approvers when a BP has been pending > ThresholdHours.
BudgetPlanReminder__Enabled=true
BudgetPlanReminder__IntervalMinutes=60
BudgetPlanReminder__ThresholdHours=24
# Minimum hours between reminder notifications for the same BP (prevents spam).
BudgetPlanReminder__CooldownHours=24
# Only send notifications/emails within this local-time window (inclusive start, exclusive end).
# Use IANA timezone IDs (e.g. Asia/Jakarta, Asia/Singapore, UTC).
BudgetPlanReminder__ActiveWindowStartHour=9
BudgetPlanReminder__ActiveWindowEndHour=17
BudgetPlanReminder__TimeZoneId=Asia/Jakarta

# HybridCache TTLs
# Each entry is a process-local in-memory cache with the configured TTL.
Cache__RbacPermission__TtlSeconds=60
Cache__PermissionsCatalog__TtlSeconds=300
Cache__Uom__TtlSeconds=300
Cache__ActivityType__TtlSeconds=300
Cache__WorkflowTemplate__TtlSeconds=300
Cache__WarehouseShadow__TtlSeconds=120
Cache__RateCard__TtlSeconds=120

# PDF Export
# Hard cap on rows per PDF export (prevents OOM on large datasets).
Pdf__MaxRows=5000

# Rate Limiting
# Sliding window rate limit applied per IP to POST /auth/login and POST /auth/refresh.
# Exceeding returns 429 Too Many Requests. Increase in low-risk internal environments.
RateLimit__Auth__PermitLimit=10
RateLimit__Auth__WindowSeconds=60

# OpenTelemetry
# Exports traces + metrics via OTLP. Works with any OTLP-compatible backend:
#   SigNoz (recommended): https://signoz.io/docs/install/docker/
#   Grafana Tempo:        docker run -p 4317:4317 grafana/tempo:latest -config.file=/etc/tempo.yaml
#   Grafana otel-lgtm:   docker run -p 4317:4317 -p 3000:3000 grafana/otel-lgtm:latest
#   Datadog, Honeycomb, Dynatrace, etc. - all accept OTLP
#
# Point OtlpEndpoint at whichever backend's OTLP gRPC port (usually 4317).
OpenTelemetry__Enabled=false
OpenTelemetry__ServiceName=wams
OpenTelemetry__OtlpEndpoint=http://localhost:4317
# Expose Prometheus scrape endpoint at /metrics (leave false unless behind an auth proxy)
OpenTelemetry__Prometheus__Enabled=false
# Fraction of requests to sample as traces: 1.0 = 100%, 0.1 = 10%
OpenTelemetry__Tracing__SamplingRatio=1.0

# Object Storage
# Leave Endpoint empty to use local disk storage (development default).
# Set Endpoint + credentials to enable S3-compatible object storage (production).
# Supported providers: MinIO, AWS S3, Cloudflare R2, Backblaze B2, Synology/QNAP NAS, TrueNAS.
#
# MinIO (self-hosted):
#   ObjectStorage__Endpoint=https://minio.company.com:9000
#   ObjectStorage__ForcePathStyle=true
#
# AWS S3:
#   ObjectStorage__Endpoint=https://s3.amazonaws.com
#   ObjectStorage__Region=ap-southeast-1
#   ObjectStorage__ForcePathStyle=false
#
# Cloudflare R2:
#   ObjectStorage__Endpoint=https://<account-id>.r2.cloudflarestorage.com
#   ObjectStorage__ForcePathStyle=true
ObjectStorage__Endpoint=
ObjectStorage__AccessKey=
ObjectStorage__SecretKey=
ObjectStorage__BucketName=
ObjectStorage__Region=us-east-1
ObjectStorage__ForcePathStyle=true

# Email (SMTP) 
# Set Enabled=true and fill in the SMTP details to activate email notifications.
# Keep Enabled=false (default) to use the no-op sender (logs only).
Email__Enabled=false
Email__Host=smtp.example.com
Email__Port=587
Email__Username=
Email__Password=
Email__FromAddress=noreply@example.com
Email__FromName="WAMS System"
Email__UseSsl=true
